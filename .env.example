# Copie ce fichier en ".env" et remplis-le avec les valeurs de TON projet Supabase
# (Supabase > Project Settings > API). Ces deux clés sont publiques (protégées par les RLS).
VITE_SUPABASE_URL="https://<ref-du-projet>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<clé publishable / anon>"
VITE_SUPABASE_PROJECT_ID="<ref-du-projet>"

# Mêmes valeurs, lues côté serveur (SSR)
SUPABASE_URL="https://<ref-du-projet>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<clé publishable / anon>"
SUPABASE_PROJECT_ID="<ref-du-projet>"

# SECRÈTE — uniquement si tu ajoutes des fonctions serveur admin. Ne jamais la committer.
# SUPABASE_SERVICE_ROLE_KEY=""
